%YAML 1.2
---
name: XYZ Molecule
file_extensions:
  - xyz
scope: source.xyz-molecule

variables:
  number: '[+-]?(?:\d+\.\d*|\.\d+|\d+)(?:[eE][+-]?\d+)?'

contexts:
  main:
    - match: '^\s*(\d+)\s*$'
      captures:
        1: constant.numeric.atom-count.xyz
      set: comment

  comment:
    - match: '^.*$'
      scope: comment.line.xyz
      set: atoms

  atoms:
    - match: '^\s*(\d+)\s*$'
      captures:
        1: constant.numeric.atom-count.xyz
      set: comment

    - match: '^\s*([A-Z][a-z]?|\d{1,3})\s+({{number}})\s+({{number}})\s+({{number}})\s*$'
      captures:
        1: variable.other.atom.xyz
        2: constant.numeric.coordinate.xyz
        3: constant.numeric.coordinate.xyz
        4: constant.numeric.coordinate.xyz
