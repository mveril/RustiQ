export RUSTIQ_DEV_SHELL="${RUSTIQ_DEV_SHELL:-full}"
source_env_if_exists .envrc.local

case "$RUSTIQ_DEV_SHELL" in
mini-rust | rust | mini-pyscf | full) ;;
*)
  log_error "Unknown RustiQ development shell: $RUSTIQ_DEV_SHELL"
  log_error "Choose one of: mini-rust, rust, mini-pyscf, full"
  return 1
  ;;
esac

use flake ".#$RUSTIQ_DEV_SHELL"
