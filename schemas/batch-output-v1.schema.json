{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mveril/RustiQ/schemas/batch-output-v1.schema.json",
  "title": "RustiQ batch output",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "calculations"],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "batch" },
    "calculations": {
      "type": "array",
      "minItems": 2,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["index", "status", "result"],
            "properties": {
              "index": { "type": "integer", "minimum": 0 },
              "status": { "enum": ["success", "non_converged"] },
              "result": { "$ref": "calculation-output-v1.schema.json" }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["index", "status", "error"],
            "properties": {
              "index": { "type": "integer", "minimum": 0 },
              "status": { "const": "error" },
              "error": {
                "type": "object",
                "additionalProperties": false,
                "required": ["message"],
                "properties": { "message": { "type": "string" } }
              }
            }
          }
        ]
      }
    }
  }
}
